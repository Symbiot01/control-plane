# Control Plane Phase 1 – environment example
# Copy to .env and set real values. Do not commit .env.
# All variables below are required at runtime; missing ones raise validation errors.
# In Docker/Coolify, set the same names as environment variables (no .env file needed).

# Database – set either DATABASE_URL or all of POSTGRES_* (app builds asyncpg URL from POSTGRES_*)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/control_plane
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=control_plane
# libpq / asyncpg: disable (default, local), require for typical managed Postgres
POSTGRES_SSLMODE=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Google Cloud Platform – service account as single-line JSON (Firebase, Cloud SQL, etc.)
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# JWT (RS256) – PEM content (paste full key; use \n for newlines in .env)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=control-plane
JWT_EXPIRATION_MINUTES=30

# Internal API (Product Plane) – required for /internal/*
INTERNAL_API_KEY=your-internal-api-key

# Environment
ENVIRONMENT=development

ORG_CONSOLE_URL=http://localhost:8080
